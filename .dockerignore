# Keep secrets, local data and build artifacts out of the build context.
# "**/" is needed: unlike .gitignore, patterns here only match at the root otherwise.
**/.env
**/.env.*
**/*.env
**/*.pem
**/*.key
**/*.log
**/data/
**/downloads/

.git/
.github/
.claude/
.githooks/
docs/
scripts/

**/node_modules/
**/dist/
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
