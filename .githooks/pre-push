#!/bin/sh
# Block direct pushes to main (substitute for GitHub branch protection until it is available).
# git passes one line per ref: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct push to main is not allowed. Use a feature branch and a pull request." >&2
    exit 1
  fi
done
exit 0
