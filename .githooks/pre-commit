#!/bin/sh
# Block commits that contain secrets. Enable once with: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found. Install it (see docs/HARNESS.md) before committing." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner .
