# Kopieren nach .env und ausfüllen. .env wird nie committet.

# --- Lernraum (Moodle) ---
MOODLE_URL=https://lernraum.th-luebeck.de
# Token holen mit: python3 scripts/moodle_test.py
MOODLE_TOKEN=

# Demo-Modus: true = erfundene Beispieldaten statt echtem Lernraum (für Screenshots/Tests)
DEMO_MODE=false

# Neue Kurse automatisch ausblenden, wenn der Name NICHT zu diesem Muster passt (leer = alle anzeigen)
# Beispiel nur aktuelles Semester:  COURSE_FILTER=WiSe 26/27
COURSE_FILTER=

# --- Zeitplan ---
SYNC_INTERVAL_MINUTES=60
REMINDER_HOUR=18
TIMEZONE=Europe/Berlin

# --- Datenbank ---
# In Docker wird DATABASE_URL automatisch gesetzt. Lokal ohne Docker (nur db-Container läuft,
# Port 5432 auf 127.0.0.1) z. B.:
# DATABASE_URL=postgresql://cockpit:<POSTGRES_PASSWORD>@localhost:5432/cockpit
# Nur Buchstaben und Ziffern verwenden – das Passwort steht unverändert in DATABASE_URL.
POSTGRES_PASSWORD=bitte-aendern

# --- LLM für Hintergrund-Agenten (ab Stufe 2) ---
# Anbieter: anthropic | openai (= jede OpenAI-kompatible API, z. B. KI-Zugang der TH)
LLM_PROVIDER=anthropic
# Nur für openai nötig, z. B. https://api.openai.com/v1 oder Endpunkt der TH
LLM_BASE_URL=
LLM_API_KEY=
# Modellname beim gewählten Anbieter
LLM_MODEL=

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Schutz des Dashboards (optional, HTTP Basic) ---
APP_USER=sahan
APP_PASSWORD=
