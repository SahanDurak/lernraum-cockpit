# Kopieren nach .env und ausfüllen. .env wird nie committet.

# --- Lernraum (Moodle) ---
MOODLE_URL=https://lernraum.th-luebeck.de
# Token holen mit: python3 scripts/moodle_test.py
MOODLE_TOKEN=

# Demo-Modus: true = erfundene Beispieldaten statt echtem Lernraum (für Screenshots/Tests)
DEMO_MODE=false

# Neue Kurse automatisch ausblenden, wenn der Name NICHT zu diesem Muster passt (leer = alle anzeigen)
# Beispiel nur aktuelles Semester:  COURSE_FILTER=WiSe 26/27
COURSE_FILTER=

# --- Zeitplan ---
SYNC_INTERVAL_MINUTES=60
REMINDER_HOUR=18
TIMEZONE=Europe/Berlin

# --- Datenbank ---
# In Docker wird DATABASE_URL automatisch gesetzt. Lokal ohne Docker z. B.:
# DATABASE_URL=sqlite:///./data/cockpit.db
POSTGRES_PASSWORD=bitte-aendern

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Schutz des Dashboards (optional, HTTP Basic) ---
APP_USER=sahan
APP_PASSWORD=
